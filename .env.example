# Copy to .env.local and adjust.

# Platform name (each church sets its own name and logo inside the app)
VITE_PLATFORM_NAME=Friends Church
VITE_PLATFORM_SUBTITLE=Quakers
VITE_PLATFORM_TAGLINE=One home online for every Friends meeting: worship, Scripture, song and fellowship.

# Where the Django API lives.
# Leave empty in development: Vite proxies /api and /ws to VITE_DEV_BACKEND.
# In production set it to the API origin, e.g. https://api.example.org
VITE_API_URL=
VITE_DEV_BACKEND=http://127.0.0.1:8000

# Church subdomains: each church is served at <slug>.<base domain>. Leave empty in development (churches stay at /c/<slug>).
# To try subdomains locally: VITE_TENANT_BASE_DOMAIN=localhost:5173 here and TENANT_BASE_DOMAIN=localhost:5173 plus
# TENANT_URL_SCHEME=http in the backend, then open http://<church-slug>.localhost:5173 (browsers resolve *.localhost).
VITE_TENANT_BASE_DOMAIN=
